rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 이메일 기반 관리자 (Firebase Auth)인지 확인하는 함수
    function isFirebaseAuthAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }
    
    // 카카오 기반 관리자인지 확인하는 함수 (members 컬렉션의 role 참조)
    // 보안 경고: 클라이언트 인증 방식에 따라 이 부분은 서버 환경에 맞게 커스텀해야 할 수 있습니다. 
    // 본 시스템에서는 이메일 Firebase Auth 관리자가 최고 관리자(super_admin) 역할을 대행합니다.
    function isSuperAdmin() {
      return isFirebaseAuthAdmin() || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isGeneralAdmin() {
      return isSuperAdmin() || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'general_admin';
    }

    // 카카오로 로그인한 최고 관리자인지 확인 (members 문서 ID = 카카오 ID = auth uid)
    function isKakaoSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('role', 'user') == 'super_admin';
    }

    // 카카오 최고 관리자가 허용되는 권한 변경: 일반 관리자 승격/해제만 가능 (최고 관리자 대상·최고 관리자 부여 불가)
    function isGeneralAdminToggle() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && request.resource.data.role in ['general_admin', 'user']
        && resource.data.get('role', 'user') != 'super_admin';
    }

    // 로그인한 본인인지 (members 문서 ID = 카카오 ID = auth uid)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 글(리뷰·문의)의 작성자인지: authorId 가 숫자로 저장돼 있어도 문자열로 저장돼 있어도 비교된다
    function isAuthor(data) {
      return request.auth != null && data.get('authorId', null) != null
        && ((data.authorId is int && data.authorId == int(request.auth.uid))
            || (data.authorId is string && data.authorId == request.auth.uid));
    }

    // 예약 문서의 주인인지 (예약의 kakaoUid 는 숫자, auth uid 는 문자열이라 숫자로 바꿔서 비교)
    function ownsReservation(data) {
      return request.auth != null && data.get('kakaoUid', null) != null && data.kakaoUid == int(request.auth.uid);
    }

    // members 컬렉션 규칙
    //  - 읽기: 본인 문서, 또는 관리자(목록 포함)
    //  - 가입: 로그인한 본인의 문서만, 그리고 role(관리자 권한)은 가입 때 넣을 수 없다
    //  - 수정: 본인(단, role 변경 불가) 또는 관리자
    match /members/{userId} {
      allow get: if isOwner(userId) || isGeneralAdmin();
      allow list: if isGeneralAdmin();
      allow create: if isOwner(userId) && !('role' in request.resource.data);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isFirebaseAuthAdmin()
                    || (isKakaoSuperAdmin() && isGeneralAdminToggle());
      allow delete: if isFirebaseAuthAdmin();
      
      // 포인트 적립 묶음/내역: 본인과 관리자만 읽기. 쓰기는 서버(Cloud Functions)만 가능
      match /point_lots/{lotId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isGeneralAdmin());
        allow write: if false;
      }
      match /point_logs/{logId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isGeneralAdmin());
        allow write: if false;
      }

      // 사용자 본인의 쿠폰함 규칙
      match /coupons/{couponId} {
        allow read: if isOwner(userId) || isGeneralAdmin();
        // 리뷰 작성/신규 가입 후 본인 계정에 쿠폰 생성 (본인 또는 관리자만)
        allow create: if isOwner(userId) || isGeneralAdmin();
        // 결제 완료 시 본인이 active → used 로만 상태 변경 가능 (다른 필드 변경 불가)
        allow update: if isGeneralAdmin() || (
          isOwner(userId)
          && resource.data.status == 'active'
          && request.resource.data.status == 'used'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isUsed', 'usedAt'])
        );
        allow delete: if isGeneralAdmin();
      }
    }

    // 청소 보증금 환급 계좌: 고객은 새로 만들기만 가능(읽기 불가), 조회·수정·삭제는 관리자만
    //  - 만들기: 로그인한 본인이, 본인 명의로 이미 저장된 예약에 대해서만 (남의 예약 번호로 만들 수 없다)
    //  - 개인정보 수집·이용 동의(consent) 정보와 함께 저장
    match /reservation_private/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['reservationId', 'kakaoUid', 'bank', 'account', 'holder', 'consent', 'consentAt', 'createdAt'])
                    && request.resource.data.kakaoUid == int(request.auth.uid)
                    && request.resource.data.get('consent', false) == true
                    && exists(/databases/$(database)/documents/reservations/$(id))
                    && get(/databases/$(database)/documents/reservations/$(id)).data.get('kakaoUid', null) == int(request.auth.uid)
                    && request.resource.data.account is string && request.resource.data.account.size() <= 20
                    && request.resource.data.bank is string && request.resource.data.bank.size() <= 30
                    && request.resource.data.holder is string && request.resource.data.holder.size() <= 30;
      allow read, update, delete: if isGeneralAdmin();
    }

    // 예약 가능 시간 표시용 공개 데이터: 날짜·시간만 있고 개인정보는 없다. 쓰기는 서버(Cloud Functions)만 가능
    match /booked_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // 결제 중 포인트 선차감 기록: 클라이언트 접근 불가(서버 전용)
    match /point_holds/{holdId} {
      allow read, write: if false;
    }

    // 리뷰 컬렉션 규칙
    match /reviews/{docId} {
      allow read: if true;
      // 본인 명의로만 작성 (남의 이름으로 리뷰 작성 불가)
      allow create: if isAuthor(request.resource.data);
      allow update, delete: if isGeneralAdmin() || isAuthor(resource.data);
    }

    // community (notices, inquiries) 규칙
    match /notices/{docId} {
      allow read: if true;
      allow write: if isGeneralAdmin();
    }
    
    // 문의: 내용·비밀번호가 들어 있어서 작성자와 관리자만 읽을 수 있다 (목록은 본인 글만 조회)
    match /inquiries/{docId} {
      allow read: if isGeneralAdmin() || isAuthor(resource.data);
      allow create: if isAuthor(request.resource.data);
      allow update, delete: if isGeneralAdmin() || isAuthor(resource.data);
    }

    // reservations 컬렉션 규칙
    match /reservations/{resId} {
      // 본인 예약이거나 관리자만 읽을 수 있음 (예약 가능 시간은 booked_slots 에서 공개)
      allow read: if ownsReservation(resource.data) || isGeneralAdmin();
      // 새 예약은 로그인한 본인 명의의 "승인 대기" 상태로만 만들 수 있다 (승인·거절·문자 발송 상태를 클라이언트가 직접 정하지 못하게)
      allow create: if request.auth != null
                    && request.resource.data.get('kakaoUid', null) != null
                    && request.resource.data.kakaoUid == int(request.auth.uid)
                    && request.resource.data.get('approvalStatus', 'pending') == 'pending'
                    && !('approvedAt' in request.resource.data)
                    && !('rejected' in request.resource.data)
                    && !('confirmSmsSentAt' in request.resource.data)
                    && !('reminderSentAt' in request.resource.data);

      // 예약 수정: 관리자, 또는 이용자의 후기 작성 표시(hasReview)만 가능. 상태/승인 변경은 서버 함수(Admin)가 처리
      allow update: if isGeneralAdmin()
                    || (ownsReservation(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasReview']));
      allow delete: if isFirebaseAuthAdmin();
    }

    // 통계나 설정 파일 규칙
    // 사이트 설정(CMS): 화면을 그리려면 누구나 읽어야 하지만, 수정은 관리자만 가능
    match /monory_config/{configId} {
      allow read: if true;
      allow write: if isGeneralAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isGeneralAdmin();
      }
    }

    // 공간 갤러리 사진 규칙
    match /gallery_photos/{docId} {
      allow read: if true;
      allow write: if isFirebaseAuthAdmin() || isGeneralAdmin();
    }
    
  }
}
